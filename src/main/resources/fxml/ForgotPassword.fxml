<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.manager.controller.ForgotPasswordController"
      alignment="CENTER"
      spacing="12"
      styleClass="auth-screen">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="Reset Password" styleClass="screen-title" />
    <Label text="Enter your email to reset your password" styleClass="subtitle" />

    <VBox maxWidth="360" spacing="6">
        <Label text="Email" styleClass="field-label" />
        <TextField fx:id="emailField" promptText="Enter your email" />
        <Label fx:id="messageLabel" wrapText="true" styleClass="message-label" />

        <Button text="Send Reset Email" onAction="#handleResetPassword" maxWidth="Infinity" styleClass="primary-button" />
        <Hyperlink text="Back to Login" onAction="#handleLogin" />
    </VBox>
</VBox>
