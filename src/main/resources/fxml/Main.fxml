<?import com.finance.manager.ui.GlobalSearchBar?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finance.manager.controller.FinanceShellController" styleClass="dashboard-root">
<BorderPane>
<top><VBox styleClass="navbar-wrapper"><HBox alignment="CENTER_LEFT" spacing="18" styleClass="navbar"><Button fx:id="menuToggle" text="☰" onAction="#handleSidebarToggle" styleClass="navbar-menu-button"/><VBox spacing="0" styleClass="brand-block"><Label text="Khatabook" styleClass="navbar-brand"/><Label text="FINANCE MANAGER" styleClass="navbar-tagline"/></VBox><HBox HBox.hgrow="ALWAYS" alignment="CENTER"><GlobalSearchBar/></HBox><HBox alignment="CENTER" spacing="7" styleClass="navbar-actions"><Button fx:id="addTransactionNav" text="＋ Add" onAction="#handleAddTransactionNav" styleClass="navbar-add-button"/><Button text="👤" onAction="#handleProfileMenu" styleClass="navbar-menu-button"/></HBox></HBox><HBox alignment="CENTER_LEFT" spacing="12" styleClass="welcome-bar"><VBox HBox.hgrow="ALWAYS" spacing="2"><Label fx:id="welcomeLabel" text="Welcome" styleClass="welcome-label"/><Label fx:id="emailLabel" text="Signed in" styleClass="subtitle"/></VBox><Button text="Export CSV" onAction="#handleExportCsv" styleClass="secondary-button"/></HBox></VBox></top>
<center><ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="dashboard-scroll-pane"><content><VBox spacing="20" styleClass="dashboard-content">
<VBox fx:id="dashboardSection" spacing="14" styleClass="dashboard-page"><VBox alignment="CENTER" spacing="3" maxWidth="1.7976931348623157E308"><Label text="Good to see you 👋" styleClass="page-title"/><Label text="Your personal finance command center" styleClass="subtitle"/></VBox><GridPane hgap="14" styleClass="summary-row"><columnConstraints><ColumnConstraints percentWidth="33.3333" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.3333" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.3334" hgrow="ALWAYS"/></columnConstraints><VBox GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.fillWidth="true" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="summary-card"><HBox alignment="CENTER_LEFT" spacing="16"><Label text="▣" style="-fx-min-width: 58px; -fx-min-height: 58px; -fx-max-width: 58px; -fx-max-height: 58px; -fx-alignment: center; -fx-background-color: #dbeafe; -fx-background-radius: 16px; -fx-text-fill: #2563eb; -fx-font-size: 27px; -fx-font-weight: bold;"/><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="TOTAL BALANCE" styleClass="card-title"/><Label fx:id="balanceLabel" text="₹0.00" styleClass="balance-value"/></VBox></HBox></VBox><VBox GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.fillWidth="true" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="summary-card"><HBox alignment="CENTER_LEFT" spacing="16"><Label text="↗" style="-fx-min-width: 58px; -fx-min-height: 58px; -fx-max-width: 58px; -fx-max-height: 58px; -fx-alignment: center; -fx-background-color: #dcfce7; -fx-background-radius: 16px; -fx-text-fill: #15803d; -fx-font-size: 30px; -fx-font-weight: bold;"/><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="TOTAL INCOME" styleClass="card-title"/><Label fx:id="incomeLabel" text="₹0.00" styleClass="income-value"/></VBox></HBox></VBox><VBox GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.fillWidth="true" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="summary-card"><HBox alignment="CENTER_LEFT" spacing="16"><Label text="↘" style="-fx-min-width: 58px; -fx-min-height: 58px; -fx-max-width: 58px; -fx-max-height: 58px; -fx-alignment: center; -fx-background-color: #fee2e2; -fx-background-radius: 16px; -fx-text-fill: #dc2626; -fx-font-size: 30px; -fx-font-weight: bold;"/><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="TOTAL EXPENSE" styleClass="card-title"/><Label fx:id="expenseLabel" text="₹0.00" styleClass="expense-value"/></VBox></HBox></VBox></GridPane></VBox>
<VBox fx:id="analyticsSection" spacing="14" styleClass="dashboard-page"><VBox spacing="3" styleClass="analytics-header"><Label text="Financial Analytics" styleClass="page-title"/><Label text="Income, expense and spending patterns from your recorded transactions." styleClass="subtitle"/></VBox><HBox spacing="14" prefHeight="350" styleClass="analytics-chart-row"><VBox HBox.hgrow="ALWAYS" styleClass="summary-card analytics-chart-card"><HBox alignment="CENTER_LEFT" spacing="8"><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="Income vs Expense" styleClass="section-title"/><Label text="Monthly comparison of money received and money spent." styleClass="subtitle"/></VBox><Label text="Monthly view" styleClass="analytics-chart-badge"/></HBox><BarChart fx:id="monthlyChart" animated="false" legendVisible="true" VBox.vgrow="ALWAYS"><xAxis><CategoryAxis label="Month"/></xAxis><yAxis><NumberAxis label="Amount (₹)"/></yAxis></BarChart></VBox><VBox HBox.hgrow="ALWAYS" styleClass="summary-card analytics-chart-card"><HBox alignment="CENTER_LEFT" spacing="8"><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="Expense Distribution" styleClass="section-title"/><Label text="Category-wise share of your recorded expenses." styleClass="subtitle"/></VBox><Label text="By category" styleClass="analytics-chart-badge"/></HBox><PieChart fx:id="expenseChart" animated="false" legendVisible="true" VBox.vgrow="ALWAYS"/></VBox></HBox><HBox alignment="CENTER_LEFT" spacing="10" styleClass="analytics-summary-strip"><VBox HBox.hgrow="ALWAYS"><Label text="Reading the charts" styleClass="analytics-summary-title"/><Label text="Use the monthly chart to compare cash coming in versus going out. Use the pie chart to spot categories taking the largest share of expenses." styleClass="analytics-summary-text" wrapText="true"/></VBox></HBox></VBox>
<VBox fx:id="notificationsSection" spacing="12" styleClass="dashboard-page"><Label text="Alerts &amp; Notifications" styleClass="page-title"/><fx:include source="Notifications.fxml"/></VBox>
<VBox fx:id="reportsSection" spacing="12" styleClass="dashboard-page"><Label text="Financial Reports" styleClass="page-title"/><VBox spacing="12" styleClass="summary-card"><HBox alignment="CENTER_LEFT" spacing="12"><VBox HBox.hgrow="ALWAYS"><Label text="Monthly Report" styleClass="section-title"/><Label text="Select a month to view your financial summary." styleClass="subtitle"/></VBox><ComboBox fx:id="reportMonthCombo" prefWidth="170"/></HBox><HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="summary-card"><Label text="Income" styleClass="card-title"/><Label fx:id="reportIncomeLabel" text="₹0.00" styleClass="income-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="summary-card"><Label text="Expense" styleClass="card-title"/><Label fx:id="reportExpenseLabel" text="₹0.00" styleClass="expense-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="summary-card"><Label text="Savings" styleClass="card-title"/><Label fx:id="reportSavingsLabel" text="₹0.00" styleClass="balance-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="summary-card"><Label text="Budget" styleClass="card-title"/><Label fx:id="reportBudgetLabel" text="₹0.00" styleClass="balance-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="summary-card"><Label text="Remaining" styleClass="card-title"/><Label fx:id="reportRemainingLabel" text="₹0.00" styleClass="balance-value"/></VBox></HBox></VBox><PieChart fx:id="reportExpenseChart" title="Selected Month Expense by Category" animated="false" legendVisible="true" prefHeight="300"/></VBox>
<VBox fx:id="goalsSection" spacing="12" styleClass="dashboard-page"><Label text="Savings Goals" styleClass="page-title"/><fx:include source="Goals.fxml"/></VBox>
<VBox fx:id="budgetSection" spacing="12" styleClass="dashboard-page"><Label text="Monthly Budget" styleClass="page-title"/><VBox spacing="14" styleClass="summary-card"><HBox alignment="CENTER_LEFT" spacing="12"><VBox HBox.hgrow="ALWAYS"><Label text="Budget for" styleClass="section-title"/><Label fx:id="budgetMonthLabel" text="Current Month" styleClass="subtitle"/></VBox><TextField fx:id="budgetField" promptText="Budget amount" prefWidth="170"/><Button fx:id="editBudgetButton" text="Edit Budget" styleClass="secondary-button"/><Button fx:id="saveBudgetButton" text="Save Budget" onAction="#handleSaveBudget" styleClass="primary-button"/></HBox><ProgressBar fx:id="budgetProgressBar" progress="0" maxWidth="1.7976931348623157E308"/><HBox spacing="28"><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Spent this month" styleClass="card-title"/><Label fx:id="budgetSpentLabel" text="₹0.00" styleClass="expense-value"/></VBox><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Remaining" styleClass="card-title"/><Label fx:id="budgetRemainingLabel" text="₹0.00" styleClass="balance-value"/></VBox><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Saved" styleClass="card-title"/><Label fx:id="budgetSavedLabel" text="₹0.00" styleClass="income-value"/></VBox><VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Budget Used" styleClass="card-title"/><Label fx:id="budgetPercentageLabel" text="0.0% used" styleClass="balance-value"/></VBox></HBox></VBox></VBox>
<VBox fx:id="addTransactionSection" spacing="12" styleClass="dashboard-page"><Label text="Add Transaction" styleClass="page-title"/><GridPane hgap="14" vgap="10" styleClass="transaction-form"><Label text="Type" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/><Label text="Amount" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="Category" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/><Label text="Description" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/><Label text="Date" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="0"/><ComboBox fx:id="typeCombo" prefWidth="130" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="amountField" promptText="0.00" prefWidth="140" GridPane.columnIndex="1" GridPane.rowIndex="1"/><ComboBox fx:id="categoryCombo" prefWidth="140" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="descriptionField" promptText="Optional note" prefWidth="230" GridPane.columnIndex="3" GridPane.rowIndex="1"/><DatePicker fx:id="datePicker" prefWidth="145" GridPane.columnIndex="4" GridPane.rowIndex="1"/><Button fx:id="addButton" text="Add Transaction" onAction="#handleAddTransaction" styleClass="primary-button" GridPane.columnIndex="5" GridPane.rowIndex="1"/></GridPane></VBox>
<VBox fx:id="transactionsSection" spacing="12" styleClass="dashboard-page"><Label text="Transactions" styleClass="page-title"/><HBox spacing="10" styleClass="filter-bar"><TextField fx:id="searchField" promptText="Search description, category or type..." prefWidth="340"/><ComboBox fx:id="filterTypeCombo" prefWidth="140"/><ComboBox fx:id="filterCategoryCombo" prefWidth="160"/></HBox><TableView fx:id="transactionTable" prefHeight="430" styleClass="transaction-table"><columns><TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/><TableColumn fx:id="amountColumn" text="Amount" prefWidth="150"/><TableColumn fx:id="categoryColumn" text="Category" prefWidth="140"/><TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/><TableColumn fx:id="dateColumn" text="Date" prefWidth="130"/><TableColumn fx:id="actionColumn" text="Actions" prefWidth="160"/></columns></TableView><HBox alignment="CENTER_LEFT"><Label fx:id="statusLabel" text="Ready" styleClass="message-label"/><Label text="" HBox.hgrow="ALWAYS"/><Button text="Export CSV" onAction="#handleExportCsv" styleClass="secondary-button"/></HBox></VBox>
</VBox></content></ScrollPane></center>
</BorderPane>
<VBox fx:id="sidebar" managed="false" visible="false" mouseTransparent="true" StackPane.alignment="TOP_LEFT" spacing="10" styleClass="sidebar" style="-fx-pref-width: 300px; -fx-min-width: 300px; -fx-max-width: 300px; -fx-background-color: linear-gradient(to bottom, #0f172a, #172554, #312e81); -fx-padding: 24px 16px 20px 16px; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.38), 24, 0.22, 5, 0);"><HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-header"><VBox spacing="0" HBox.hgrow="ALWAYS"><Label text="Khatabook" styleClass="sidebar-brand"/><Label text="FINANCE MANAGER" styleClass="sidebar-tagline"/></VBox><Label text="MENU" styleClass="sidebar-menu-label"/></HBox><Label text="NAVIGATION" styleClass="sidebar-section-label"/><Button fx:id="dashboardNav" text="⌂  Dashboard" onAction="#handleDashboardNav" maxWidth="1.7976931348623157E308" styleClass="nav-button, nav-button-active"/><Button fx:id="analyticsNav" text="◈  Analytics" onAction="#handleAnalyticsNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Button fx:id="notificationsNav" text="●  Alerts" onAction="#handleNotificationsNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Button fx:id="reportsNav" text="▣  Reports" onAction="#handleReportsNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Button fx:id="goalsNav" text="★  Goals" onAction="#handleGoalsNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Button fx:id="budgetNav" text="▤  Budget" onAction="#handleBudgetNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Button fx:id="transactionsNav" text="☷  Transactions" onAction="#handleTransactionsNav" maxWidth="1.7976931348623157E308" styleClass="nav-button"/><Label text="QUICK ACTION" styleClass="sidebar-section-label"/><Button fx:id="sidebarAddButton" text="＋  Add Transaction" onAction="#handleAddTransactionNav" maxWidth="1.7976931348623157E308" styleClass="sidebar-add-button"/></VBox>
<VBox fx:id="profileCard" managed="false" visible="false" mouseTransparent="true" StackPane.alignment="TOP_RIGHT" translateX="-12" translateY="70" spacing="10" styleClass="profile-card" style="-fx-pref-width: 290px; -fx-min-width: 290px; -fx-max-width: 290px; -fx-padding: 16px;"><HBox alignment="CENTER_LEFT" spacing="11" styleClass="profile-header"><Label text="👤" styleClass="profile-avatar"/><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="My Profile" styleClass="profile-title"/><Label text="Khatabook Account" styleClass="profile-subtitle"/><Label text="ACTIVE" styleClass="profile-status-badge"/></VBox></HBox><VBox spacing="8" styleClass="profile-details"><VBox spacing="2"><Label text="ACCOUNT EMAIL" styleClass="profile-label"/><Label fx:id="profileEmailLabel" text="-" styleClass="profile-value" wrapText="true"/></VBox><HBox alignment="CENTER_LEFT" spacing="8"><Label text="●" styleClass="profile-status-dot"/><VBox spacing="1"><Label text="ACCOUNT STATUS" styleClass="profile-label"/><Label text="Active account" styleClass="profile-active"/></VBox></HBox></VBox><Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="profile-logout"/></VBox>
</StackPane>