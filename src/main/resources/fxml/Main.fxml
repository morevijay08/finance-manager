<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.manager.controller.DashboardController"
            styleClass="dashboard-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <Label text="Khatabook Finance Manager" styleClass="app-title" />
            <VBox HBox.hgrow="ALWAYS" spacing="3">
                <Label fx:id="welcomeLabel" text="Welcome" styleClass="welcome-label" />
                <Label fx:id="emailLabel" text="Signed in" styleClass="subtitle" />
            </VBox>
            <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="dashboard-content">
            <HBox spacing="14" styleClass="summary-row">
                <VBox HBox.hgrow="ALWAYS" styleClass="summary-card balance-card">
                    <Label text="Total Balance" styleClass="card-title" />
                    <Label fx:id="balanceLabel" text="₹0.00" styleClass="balance-value" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="Total Income" styleClass="card-title" />
                    <Label fx:id="incomeLabel" text="₹0.00" styleClass="income-value" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="Total Expense" styleClass="card-title" />
                    <Label fx:id="expenseLabel" text="₹0.00" styleClass="expense-value" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Add Transaction" styleClass="section-title" />
                    <Label text="Record your income and expenses" styleClass="subtitle" />
                </VBox>
            </HBox>

            <GridPane hgap="12" vgap="8" styleClass="transaction-form">
                <Label text="Type" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label text="Amount" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Category" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label text="Description" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label text="Date" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="0" />

                <ComboBox fx:id="typeCombo" prefWidth="120" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="amountField" promptText="0.00" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <ComboBox fx:id="categoryCombo" prefWidth="130" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="descriptionField" promptText="Optional note" prefWidth="190" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <DatePicker fx:id="datePicker" prefWidth="140" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                <Button fx:id="addButton" text="Add" onAction="#handleAddTransaction" styleClass="primary-button" GridPane.columnIndex="5" GridPane.rowIndex="1" />
            </GridPane>

            <HBox alignment="CENTER_LEFT">
                <Label text="Recent Transactions" styleClass="section-title" />
            </HBox>
            <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="transaction-table">
                <columns>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="120" />
                    <TableColumn fx:id="amountColumn" text="Amount" prefWidth="150" />
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140" />
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300" />
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="130" />
                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="150" />
                </columns>
            </TableView>
            <Label fx:id="statusLabel" text="Ready" styleClass="message-label" />
        </VBox>
    </center>
</BorderPane>
