<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.manager.controller.RegisterController"
      alignment="CENTER"
      spacing="10"
      styleClass="auth-screen">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40" />
    </padding>

    <Label text="Create Your Account" styleClass="screen-title" />
    <Label text="Start managing your finances" styleClass="subtitle" />

    <VBox maxWidth="360" spacing="6">
        <Label text="Full Name" styleClass="field-label" />
        <TextField fx:id="nameField" promptText="Enter your name" />

        <Label text="Email" styleClass="field-label" />
        <TextField fx:id="emailField" promptText="Enter your email" />

        <Label text="Password" styleClass="field-label" />
        <PasswordField fx:id="passwordField" promptText="Create a password" />

        <Label text="Confirm Password" styleClass="field-label" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" />

        <Label fx:id="errorLabel" wrapText="true" styleClass="error-label" />

        <Button text="Create Account" onAction="#handleRegister" maxWidth="Infinity" styleClass="primary-button" />
        <Hyperlink text="Already have an account? Login" onAction="#handleLogin" />
    </VBox>
</VBox>
