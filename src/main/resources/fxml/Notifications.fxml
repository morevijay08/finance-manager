<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.manager.controller.NotificationsController"
      spacing="16"
      styleClass="summary-card"
      style="-fx-background-color: white; -fx-background-radius: 18px; -fx-border-color: #e2e8f0; -fx-border-radius: 18px; -fx-padding: 24px; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.07), 18, 0.12, 0, 5);">

    <HBox alignment="CENTER_LEFT" spacing="14">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Notifications &amp; Alerts" styleClass="section-title" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0f172a;" />
            <Label text="Stay ahead of budget limits and upcoming recurring payments." styleClass="subtitle" />
        </VBox>
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #eff6ff; -fx-background-radius: 12px; -fx-padding: 9px 16px; -fx-border-color: #bfdbfe; -fx-border-radius: 12px;">
            <Label fx:id="alertCountLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #2563eb;" />
            <Label text="ACTIVE" style="-fx-font-size: 9px; -fx-font-weight: 800; -fx-text-fill: #64748b;" />
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="4" style="-fx-background-color: #f8fafc; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 12px 14px;">
            <Label text="Budget monitoring" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #475569;" />
            <Label fx:id="budgetStatusLabel" text="Checking your monthly budget..." style="-fx-font-size: 12px; -fx-text-fill: #64748b;" wrapText="true" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="4" style="-fx-background-color: #f8fafc; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 12px 14px;">
            <Label text="Recurring payments" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #475569;" />
            <Label fx:id="recurringStatusLabel" text="Checking upcoming payments..." style="-fx-font-size: 12px; -fx-text-fill: #64748b;" wrapText="true" />
        </VBox>
    </HBox>

    <VBox spacing="8">
        <Label text="Attention needed" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #0f172a;" />
        <ScrollPane fitToWidth="true" prefViewportHeight="260" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox fx:id="notificationsBox" spacing="10" />
            </content>
        </ScrollPane>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #f8fafc; -fx-background-radius: 10px; -fx-padding: 10px 12px;">
        <Label text="●" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;" />
        <Label fx:id="notificationStatusLabel" text="Checking alerts..." styleClass="message-label" />
    </HBox>
</VBox>
