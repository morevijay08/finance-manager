<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.manager.controller.GoalsController"
      spacing="12">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="3">
            <Label text="Financial Goals" styleClass="section-title" />
            <Label text="Set savings targets and track your progress" styleClass="subtitle" />
        </VBox>
    </HBox>

    <VBox spacing="8" styleClass="transaction-form">
        <HBox spacing="10">
            <TextField fx:id="goalNameField" promptText="Goal name (e.g. Laptop)" prefWidth="260" HBox.hgrow="ALWAYS" />
            <TextField fx:id="targetField" promptText="Target amount" prefWidth="150" />
            <TextField fx:id="savedField" promptText="Already saved" prefWidth="150" />
            <Button fx:id="addGoalButton" text="Add Goal" onAction="#handleAddGoal" styleClass="primary-button" />
        </HBox>
        <Label text="You can enter the amount already saved toward the goal." styleClass="subtitle" />
    </VBox>

    <ScrollPane fitToWidth="true" prefViewportHeight="220" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <content>
            <VBox fx:id="goalsBox" spacing="10" />
        </content>
    </ScrollPane>
    <Label fx:id="goalStatusLabel" text="Ready" styleClass="message-label" />
</VBox>
