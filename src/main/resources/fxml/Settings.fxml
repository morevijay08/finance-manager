<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finance.manager.controller.SettingsController" spacing="18" styleClass="settings-page">
    <VBox spacing="4"><Label text="Settings" styleClass="page-title"/><Label text="Manage your Hisaabi Finance Manager preferences" styleClass="subtitle"/></VBox>
    <VBox spacing="12" styleClass="summary-card">
        <Label text="Preferences" styleClass="section-title"/>
        <HBox alignment="CENTER_LEFT" spacing="12"><VBox HBox.hgrow="ALWAYS"><Label text="Notifications" styleClass="card-title"/><Label text="Show alerts for important finance activity" styleClass="subtitle"/></VBox><CheckBox text="Enabled" selected="true" fx:id="notificationsEnabled"/></HBox>
        <Separator/>
        <HBox alignment="CENTER_LEFT" spacing="12"><VBox HBox.hgrow="ALWAYS"><Label text="Currency" styleClass="card-title"/><Label text="Currency used throughout the finance dashboard" styleClass="subtitle"/></VBox><ComboBox fx:id="currencyCombo" prefWidth="150"/></HBox>
    </VBox>
    <VBox spacing="12" styleClass="summary-card">
        <Label text="Account" styleClass="section-title"/>
        <Label text="Your signed-in Firebase account is used for transactions, budgets and reports." styleClass="subtitle" wrapText="true"/>
        <Button text="Save Settings" onAction="#handleSaveSettings" styleClass="primary-button" prefWidth="150"/>
        <Label fx:id="settingsStatus" text="Settings are ready." styleClass="message-label"/>
    </VBox>
</VBox>
