rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /users/{userId} {
      // New accounts can create only their own USER profile.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.get('role', 'USER') == 'USER';

      // Users read their own profile; admins can read user profiles for administration.
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      // Users may update their own profile without changing role/status.
      // Admins may update account status but cannot change roles through this feature.
      allow update: if request.auth != null && (
          (request.auth.uid == userId
            && request.resource.data.get('role', resource.data.get('role', 'USER')) == resource.data.get('role', 'USER')
            && request.resource.data.get('status', resource.data.get('status', 'ACTIVE')) == resource.data.get('status', 'ACTIVE'))
          ||
          (isAdmin()
            && request.resource.data.get('role', resource.data.get('role', 'USER')) == resource.data.get('role', 'USER')
            && request.resource.data.get('name', resource.data.get('name', '')) == resource.data.get('name', '')
            && request.resource.data.get('email', resource.data.get('email', '')) == resource.data.get('email', ''))
        );

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /recurringTransactions/{recurringTransactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /adminAuditLogs/{logId} {
      // Only administrators can view or create audit records.
      allow read, create: if isAdmin();
      // Audit records are immutable from the client application.
      allow update, delete: if false;
    }
  }
}
